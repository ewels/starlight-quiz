#: plugin.py:628
msgid "Submit"
msgstr "Kirim"

msgid "Answer"
msgstr "Jawaban"

#: plugin.py:643
msgid "Question {n}"
msgstr "Pertanyaan {n}"

#: plugin.py:673
msgid "Quiz Progress"
msgstr "Progres Kuis"

#: plugin.py:674
msgid "questions answered"
msgstr "pertanyaan terjawab"

#: plugin.py:675
msgid "correct"
msgstr "benar"

#: plugin.py:676
msgid "Quiz Complete!"
msgstr "Kuis Selesai!"

#: plugin.py:677 plugin.py:717
msgid "Reset quiz"
msgstr "Atur ulang kuis"

#: plugin.py:714
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Hasil kuis disimpan di penyimpanan lokal browser Anda dan akan tetap ada di "
"antara sesi."

#: js/quiz.js:334
msgid "Outstanding! You aced it!"
msgstr "Luar biasa! Anda berhasil dengan sempurna!"

#: js/quiz.js:337
msgid "Great job! You really know your stuff!"
msgstr "Kerja bagus! Anda benar-benar menguasai materi ini!"

#: js/quiz.js:340
msgid "Good effort! Keep learning!"
msgstr "Usaha yang baik! Terus belajar!"

#: js/quiz.js:343
msgid "Not bad, but there's room for improvement!"
msgstr "Tidak buruk, tapi masih ada ruang untuk perbaikan!"

#: js/quiz.js:346
msgid "Better luck next time! Keep trying!"
msgstr "Semoga lebih baik lain kali! Terus mencoba!"

#: js/quiz.js:462
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr ""
"Apakah Anda yakin ingin mengatur ulang kuis? Ini akan menghapus progres "
"Anda."

#: js/quiz.js:579
msgid "Try Again"
msgstr "Coba Lagi"

#: js/quiz.js:617 js/quiz.js:755
msgid "Correct answer!"
msgstr "Jawaban benar!"

#: js/quiz.js:664 js/quiz.js:777
msgid "Incorrect answer. Please try again."
msgstr "Jawaban salah. Silakan coba lagi."

#: js/quiz.js:664 js/quiz.js:777
msgid "Incorrect answer."
msgstr "Jawaban salah."

#: overrides/main.html
msgid "Answered:"
msgstr "Dijawab:"

#: overrides/main.html
msgid "Correct:"
msgstr "Benar:"

#: overrides/main.html
msgid "Reset"
msgstr "Atur ulang"

#: js/quiz.js:677
msgid "(empty)"
msgstr "(kosong)"

# ---------------------------------------------------------------------------
# starlight-quiz only. These strings have no mkdocs-quiz counterpart (they
# belong to UI that plugin does not have: the intro panel, the mobile
# table-of-contents badge, and the page-wide reset button with its confirm
# prompt). mkdocs-quiz loads .po files into a dict and looks up msgids it
# knows, so carrying them here is inert for that plugin.
# ---------------------------------------------------------------------------
#. starlightQuiz.intro.text
msgid "Quiz answers on this page are saved to your browser's local storage and persist between visits."
msgstr "Jawaban kuis di halaman ini disimpan di penyimpanan lokal peramban Anda dan tetap tersimpan di antara kunjungan."

#. starlightQuiz.results.badge
msgid "Quiz"
msgstr "Kuis"

#. starlightQuiz.results.resetAll
msgid "Reset all answers"
msgstr "Atur ulang semua jawaban"

#. starlightQuiz.results.confirmReset
msgid "Reset every answer on this page? This cannot be undone."
msgstr "Atur ulang semua jawaban di halaman ini? Tindakan ini tidak dapat dibatalkan."
