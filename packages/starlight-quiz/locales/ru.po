#, python-brace-format
msgid "Question {n}"
msgstr "Вопрос {n}"

#: plugin.py:568
msgid "Submit"
msgstr "Отправить"

#: plugin.py
msgid "Answer"
msgstr "Ответ"

#: overrides/main.html:12 plugin.py:964
msgid "Quiz Progress"
msgstr "Прогресс викторины"

#: plugin.py:965
msgid "questions answered"
msgstr "вопросов отвечено"

#: plugin.py:966
msgid "correct"
msgstr "верно"

#: plugin.py:967
msgid "Quiz Complete!"
msgstr "Викторина завершена!"

#: plugin.py:968 plugin.py:1008
msgid "Reset quiz"
msgstr "Сбросить викторину"

#: plugin.py:1005
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Результаты викторины сохраняются в локальном хранилище браузера и "
"сохраняются между сеансами."

#: js/quiz.js:335
msgid "Outstanding! You aced it!"
msgstr "Отлично! Вы ответили правильно на все вопросы!"

#: js/quiz.js:338
msgid "Great job! You really know your stuff!"
msgstr "Отличная работа! Вы отлично разбираетесь в этом!"

#: js/quiz.js:341
msgid "Good effort! Keep learning!"
msgstr "Отличная попытка! Продолжайте учиться!"

#: js/quiz.js:344
msgid "Not bad, but there's room for improvement!"
msgstr "Неплохо, но есть над чем поработать!"

#: js/quiz.js:347
msgid "Better luck next time! Keep trying!"
msgstr "В следующий раз повезёт больше! Продолжайте попытки!"

#: js/quiz.js:463
msgid "Are you sure you want to reset the quiz? This will clear your progress."
msgstr "Хотите сбросить викторину? Это приведёт к удалению вашего прогресса."

#: js/quiz.js:586
msgid "Try Again"
msgstr "Попробовать ещё"

#: js/quiz.js:624 js/quiz.js:734 js/quiz.js:901 js/quiz.js:973
msgid "Correct answer!"
msgstr "Правильный ответ!"

#: js/quiz.js:668 js/quiz.js:783 js/quiz.js:909 js/quiz.js:995
msgid "Incorrect answer. Please try again."
msgstr "Неверный ответ. Попробуйте ещё раз."

#: js/quiz.js:668 js/quiz.js:783 js/quiz.js:909 js/quiz.js:995
msgid "Incorrect answer."
msgstr "Неверный ответ."

#: js/quiz.js:677
msgid "(empty)"
msgstr "(пусто)"

#: overrides/main.html:18 overrides/main.html:55
msgid "Answered:"
msgstr "Отвечено:"

#: overrides/main.html:33 overrides/main.html:58
msgid "Correct:"
msgstr "Верно:"

#: overrides/main.html:36 overrides/main.html:61
msgid "Reset"
msgstr "Сброс"

# ---------------------------------------------------------------------------
# starlight-quiz only. These strings have no mkdocs-quiz counterpart (they
# belong to UI that plugin does not have: the intro panel, the mobile
# table-of-contents badge, and the page-wide reset button with its confirm
# prompt). mkdocs-quiz loads .po files into a dict and looks up msgids it
# knows, so carrying them here is inert for that plugin.
# ---------------------------------------------------------------------------
#. starlightQuiz.intro.text
msgid "Quiz answers on this page are saved to your browser's local storage and persist between visits."
msgstr "Ответы на этой странице сохраняются в локальном хранилище вашего браузера и остаются доступными между посещениями."

#. starlightQuiz.results.badge
msgid "Quiz"
msgstr "Викторина"

#. starlightQuiz.results.resetAll
msgid "Reset all answers"
msgstr "Сбросить все ответы"

#. starlightQuiz.results.confirmReset
msgid "Reset every answer on this page? This cannot be undone."
msgstr "Сбросить все ответы на этой странице? Это действие нельзя отменить."
